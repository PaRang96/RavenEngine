# Keep source and project files consistent across operating systems.
* text=auto

# Source code, shaders, and build scripts use LF everywhere.
*.c text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.mm text eol=lf
*.hlsl text eol=lf
*.hlsli text eol=lf
*.cmake text eol=lf
*.in text eol=lf
CMakeLists.txt text eol=lf
CMakePresets.json text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Text-based engine content.
*.ravenlevel text eol=lf
*.ravenproject text eol=lf

# Engine assets are binary; Git should not normalize their contents.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.bmp binary
*.hdr binary
*.exr binary
*.dds binary
*.ktx binary
*.ktx2 binary
*.ico binary
*.spv binary
*.fbx binary
*.glb binary
*.blend binary
*.wav binary
*.ogg binary
*.flac binary
*.mp3 binary
*.ttf binary
*.otf binary

# Versioned machine-readable 3D scene documents.
*.ravenscene binary

# Vendored libraries are byte-identical upstream copies (ThirdParty/*/README.md records their hashes):
# Git stores and checks them out exactly as released, without line-ending conversion.
ThirdParty/** -text
