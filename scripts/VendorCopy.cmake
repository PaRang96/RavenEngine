# Shared by the update scripts of vendored libraries (the never-edit rule, AGENTS.md).
#
#   raven_vendor_copy(<folder> <source root> [VERSION <version>] <relative path>...)
#     Replaces ThirdParty/<folder> with the listed paths of an upstream release, unmodified, keeping
#     only Raven's own README.md, then writes the folder's manifest.
#   raven_vendor_manifest(<folder> [VERSION <version>])
#     Writes ThirdParty/<folder>/MANIFEST.txt for a copy made another way (ICU's filtered data).
#
# The manifest lists the git blob ID of every file except Raven's README.md, and the version when one
# is given. scripts/CheckVendored.cmake compares every copy with its manifest. Blob IDs come from
# `git hash-object`, which normalizes line endings as .gitattributes says, so one copy gives one
# manifest on every OS, whatever line endings the checkout uses.
include_guard(GLOBAL)

get_filename_component(RAVEN_VENDOR_REPOSITORY "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

# The files of ThirdParty/<folder> and their blob IDs, as "<blob> <path>" lines sorted by path.
function(raven_vendor_hashes folder out)
    set(root "${RAVEN_VENDOR_REPOSITORY}/ThirdParty/${folder}")
    if(NOT IS_DIRECTORY "${root}")
        message(FATAL_ERROR "ThirdParty/${folder} does not exist")
    endif()
    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${root}" "${root}/*")
    list(REMOVE_ITEM files README.md MANIFEST.txt)
    list(SORT files)
    set(paths "")
    foreach(file IN LISTS files)
        string(APPEND paths "ThirdParty/${folder}/${file}\n")
    endforeach()
    string(RANDOM LENGTH 12 suffix)
    file(MAKE_DIRECTORY "${RAVEN_VENDOR_REPOSITORY}/out")
    set(list_file "${RAVEN_VENDOR_REPOSITORY}/out/vendor-paths-${suffix}.txt")
    file(WRITE "${list_file}" "${paths}")
    execute_process(COMMAND git hash-object --stdin-paths
        WORKING_DIRECTORY "${RAVEN_VENDOR_REPOSITORY}" INPUT_FILE "${list_file}"
        OUTPUT_VARIABLE blobs RESULT_VARIABLE result ERROR_VARIABLE error)
    file(REMOVE "${list_file}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "git hash-object failed for ThirdParty/${folder}: ${error}")
    endif()
    string(REGEX REPLACE "\n$" "" blobs "${blobs}")
    string(REPLACE "\n" ";" blobs "${blobs}")
    list(LENGTH files count)
    list(LENGTH blobs hashed)
    if(NOT count EQUAL hashed)
        message(FATAL_ERROR "git hash-object returned ${hashed} IDs for ${count} files in ThirdParty/${folder}")
    endif()
    set(lines "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            list(GET files ${index} file)
            list(GET blobs ${index} blob)
            list(APPEND lines "${blob} ${file}")
        endforeach()
    endif()
    set(${out} "${lines}" PARENT_SCOPE)
endfunction()

function(raven_vendor_manifest folder)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "VERSION" "")
    raven_vendor_hashes(${folder} lines)
    set(text "raven-vendor-manifest 1\n")
    if(arg_VERSION)
        string(APPEND text "version ${arg_VERSION}\n")
    endif()
    foreach(line IN LISTS lines)
        string(APPEND text "${line}\n")
    endforeach()
    file(WRITE "${RAVEN_VENDOR_REPOSITORY}/ThirdParty/${folder}/MANIFEST.txt" "${text}")
    list(LENGTH lines count)
    message(STATUS "Recorded ${count} files of ThirdParty/${folder} in its MANIFEST.txt")
endfunction()

# The version a manifest records, or an empty string.
function(raven_vendor_manifest_version folder out)
    set(manifest "${RAVEN_VENDOR_REPOSITORY}/ThirdParty/${folder}/MANIFEST.txt")
    set(version "")
    if(EXISTS "${manifest}")
        file(STRINGS "${manifest}" line LIMIT_COUNT 2 REGEX "^version ")
        if(line MATCHES "^version (.+)$")
            set(version "${CMAKE_MATCH_1}")
        endif()
    endif()
    set(${out} "${version}" PARENT_SCOPE)
endfunction()

function(raven_vendor_copy folder source)
    cmake_parse_arguments(PARSE_ARGV 2 arg "" "VERSION" "")
    set(paths ${arg_UNPARSED_ARGUMENTS})
    file(REAL_PATH "${source}" source)
    foreach(path IN LISTS paths)
        if(NOT EXISTS "${source}/${path}")
            message(FATAL_ERROR "${source} does not hold ${path}; pass the root of the extracted release")
        endif()
    endforeach()
    set(target "${RAVEN_VENDOR_REPOSITORY}/ThirdParty/${folder}")
    file(MAKE_DIRECTORY "${target}")
    file(GLOB children LIST_DIRECTORIES true "${target}/*")
    foreach(child IN LISTS children)
        get_filename_component(name "${child}" NAME)
        if(NOT name STREQUAL "README.md")
            file(REMOVE_RECURSE "${child}")
        endif()
    endforeach()
    foreach(path IN LISTS paths)
        get_filename_component(parent "${target}/${path}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(COPY "${source}/${path}" DESTINATION "${parent}")
    endforeach()
    message(STATUS "Copied ${paths} into ${target}")
    if(arg_VERSION)
        raven_vendor_manifest(${folder} VERSION ${arg_VERSION})
    else()
        raven_vendor_manifest(${folder})
    endif()
endfunction()
