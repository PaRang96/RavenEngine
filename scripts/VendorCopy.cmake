# Shared by the update scripts of vendored libraries: replaces ThirdParty/<folder> with the listed paths
# of an upstream release, unmodified, keeping only Raven's own README.md.
#   raven_vendor_copy(<folder> <source root> <relative path>...)
function(raven_vendor_copy folder source)
    file(REAL_PATH "${source}" source)
    foreach(path IN LISTS ARGN)
        if(NOT EXISTS "${source}/${path}")
            message(FATAL_ERROR "${source} does not hold ${path}; pass the root of the extracted release")
        endif()
    endforeach()
    get_filename_component(repository "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(target "${repository}/ThirdParty/${folder}")
    file(GLOB children LIST_DIRECTORIES true "${target}/*")
    foreach(child IN LISTS children)
        get_filename_component(name "${child}" NAME)
        if(NOT name STREQUAL "README.md")
            file(REMOVE_RECURSE "${child}")
        endif()
    endforeach()
    foreach(path IN LISTS ARGN)
        get_filename_component(parent "${target}/${path}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(COPY "${source}/${path}" DESTINATION "${parent}")
    endforeach()
    message(STATUS "Copied ${ARGN} into ${target}")
endfunction()
