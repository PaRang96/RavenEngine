#pragma once

namespace Raven::ShaderWatchConfig
{
	// Paths are UTF-8, every byte escaped (raven_utf8_literal); std::filesystem::path reads them as UTF-8.
	inline constexpr char8_t SourceDirectory[] = @RAVEN_SHADER_SOURCE_LITERAL@;
	inline constexpr char8_t CMake[] = @RAVEN_SHADER_CMAKE_LITERAL@;
	inline constexpr char8_t CompileScript[] = @RAVEN_SHADER_SCRIPT_LITERAL@;
	inline constexpr char8_t Dxc[] = @RAVEN_SHADER_DXC_LITERAL@;
	inline constexpr char8_t Validator[] = @RAVEN_SHADER_VALIDATOR_LITERAL@;
	inline constexpr char Optimization[] = "@RAVEN_SHADER_OPTIMIZATION@";
}
